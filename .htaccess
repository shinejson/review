# Enable rewrite engine
RewriteEngine On
RewriteBase /rate/

# ============================================================
# Admin panel path aliasing
# ============================================================
# The tenant workspace is served under a non-guessable alias
# (/rate/p7xk2mqw9vrt4zhn/...) and direct browser requests to the
# real /admin/ path are refused with 403.
#
# IMPORTANT: keep the slug below in sync with ADMIN_PATH_ALIAS in
# config/database.php (or set the OPTIBIZ_ADMIN_PATH_ALIAS env var and
# update the RewriteRule here to match). Internal rewrites never change
# THE_REQUEST, so the aliased requests are not blocked by the rule above.
# NOTE: the pattern must contain NO literal spaces — Apache's tokenizer
# splits directive arguments on any unescaped space ("bad flag delimiters").
# \s/\S shorthand keeps it a single argument.
RewriteCond %{THE_REQUEST} ^[A-Z]+\s\S*/admin/ [NC]
RewriteRule ^ - [F,L]

RewriteRule ^p7xk2mqw9vrt4zhn$ p7xk2mqw9vrt4zhn/ [R=301,L]
RewriteRule ^p7xk2mqw9vrt4zhn/$ admin/index.php [L,QSA]
RewriteRule ^p7xk2mqw9vrt4zhn/(.*)$ admin/$1 [L,QSA]

# ============================================================
# SEO: sitemap + robots
# ============================================================
# /rate/sitemap.xml is generated on the fly by sitemap.php so the long tail of
# company profile pages stays in sync with the database.
# NOTE: robots.txt must be published at the DOMAIN ROOT (https://example.com/robots.txt).
# A robots.txt served from a subdirectory is ignored by crawlers — see the
# file-level comment in robots.txt and INSTALLATION.md.
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]

# Allow direct access to real existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Clean UUID rating and review page routing
# Matches e.g. /rate/01a0a9ae-8b79-758a-872e-c36f557c1abd or /rate/r/01a0a9ae-8b79-758a-872e-c36f557c1abd
RewriteRule ^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/?$ rate/index.php?uuid=$1 [QSA,L]
RewriteRule ^r/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/?$ rate/index.php?uuid=$1 [QSA,L]
RewriteRule ^rate/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/?$ rate/index.php?uuid=$1 [QSA,L]

# Remove .php extension from URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Custom error pages (optional)
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php

# Prevent directory browsing
Options -Indexes

# Protect config, documentation, and sensitive files (.env, .git, .md, .sql, backups, etc.)
<FilesMatch "(^\.env|^\.git|^\.gitignore|^composer\.(json|lock)|^package(-lock)?\.json|^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|env|gz|tar|zip|md|markdown|properties|gradle|kts|lock)|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
        Satisfy All
    </IfModule>
</FilesMatch>

# ============================================================
# Security HTTP Headers
# ============================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Clickjacking: refuse to be framed by another origin. The public review
    # widget is embedded by design, so keep SAMEORIGIN rather than DENY.
    Header always set X-Frame-Options "SAMEORIGIN"

    # Turn off the sensitive APIs this app simply never uses.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=()"

    # HSTS is only emitted on HTTPS responses (env=HTTPS), so enabling it can
    # never lock a visitor out over plain HTTP. Raise max-age to 63072000 and
    # add "; preload" once you are confident every subdomain is HTTPS-only.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # X-XSS-Protection is deprecated and can introduce issues in legacy
    # browsers; it is intentionally no longer sent. Modern protection comes
    # from a Content-Security-Policy — see SEO-AUDIT.md for the recommended
    # rollout (report-only first, because the pages use inline <style>/<script>).
</IfModule>

# ============================================================
# Force HTTPS  —  ENABLE IN PRODUCTION
# ============================================================
# Uncomment once a valid certificate is installed. The X-Forwarded-Proto check
# keeps it loop-free behind a load balancer or reverse proxy that terminates TLS.
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# Set default charset
AddDefaultCharset UTF-8

# Optimize file serving
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

# Enable gzip compression
# (image/svg+xml and application/xml are compressible too — SVG is our favicon
# format and application/xml is what sitemap.php serves.)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
