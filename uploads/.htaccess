# Block script execution in the uploads directory.
# Uploaded files are strictly static user images and must never be executed as scripts.

# 1. Deny execution of any script or dangerous file type
<FilesMatch "\.(php|php[0-9]|phtml|pht|phps|phar|cgi|pl|py|sh|bash|asp|aspx|jsp|svg|html|htm|shtml|inc|htaccess|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Neutralize execution handlers for image files
<FilesMatch "\.(gif|jpe?g|png|webp|ico|pdf)$">
    SetHandler default-handler
    <IfModule mod_php.c>
        php_flag engine off
    </IfModule>
    <IfModule mod_php7.c>
        php_flag engine off
    </IfModule>
    <IfModule mod_php8.c>
        php_flag engine off
    </IfModule>
    RemoveHandler .php .phtml .phar
</FilesMatch>

# 3. Prevent directory listing
Options -Indexes -ExecCGI