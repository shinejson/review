# Defense-in-depth: Deny execution of scripts in receipts directory
<FilesMatch "\.(php|php[0-9]|phtml|pht|phps|phar|cgi|pl|py|sh|bash|asp|aspx|jsp|svg|html|htm|shtml|inc|htaccess|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(gif|jpe?g|png|webp|ico|pdf)$">
    SetHandler default-handler
    <IfModule mod_php.c>
        php_flag engine off
    </IfModule>
    <IfModule mod_php7.c>
        php_flag engine off
    </IfModule>
    <IfModule mod_php8.c>
        php_flag engine off
    </IfModule>
    RemoveHandler .php .phtml .phar
</FilesMatch>

Options -Indexes -ExecCGI