# ============================================================
# Optibiz Production Configuration
# Copy this file to .env and adjust values for your environment.
# Make sure .env is never committed to public version control!
# ============================================================

# Environment: 'production' or 'development'
APP_ENV=production
APP_BASE_URL=https://yourdomain.com/rate

# Database Credentials
OPTIBIZ_DB_HOST=localhost
OPTIBIZ_DB_USER=optibiz_dbuser
OPTIBIZ_DB_PASS=YourStrongSecurePasswordHere!
OPTIBIZ_DB_NAME=company_rating_saas

# REST API & Mobile JWT Security (Required for API v1 - at least 32 characters)
OPTIBIZ_JWT_SECRET=change-this-to-a-very-long-and-cryptographically-secure-random-secret-key-32chars

# Allowed Origins for REST API (comma-separated list of origins)
OPTIBIZ_API_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Admin Panel Secret Alias (Optional, leave blank for default)
# OPTIBIZ_ADMIN_PATH_ALIAS=p7xk2mqw9vrt4zhn
